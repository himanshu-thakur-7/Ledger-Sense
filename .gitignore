# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Bulk generated data (see W1) — generator code under src/ledger_sense/data/
# is never ignored, only its CSV output.
data/pass*/*.csv

# Real Dodo sandbox pulls (LIVE-1) — generated wherever a human points
# --out-dir; real (if test-mode) transaction data is never committed.
data/live/

# Real secrets (see W8, .env.example) — .env.example is the checked-in
# template; .env itself must never be committed.
.env

# Close desk working artifacts (see TAPE-1) — generated wherever a human
# points --dir; demo_trace.json/.desk/ are never committed.
data/demo/
**/.desk/
demo_trace.json
