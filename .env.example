# Ledger Sense v2 — environment configuration template.
#
# Copy this file to `.env` and fill in real values there. `.env` is
# git-ignored; this file (`.env.example`) must never contain a real secret —
# every value below is a placeholder.
#
# Every var here is optional. Omitting a var (or leaving it blank) makes the
# matching integration degrade gracefully to its v1 stub/synthetic/no-tracing
# behavior — see `src/ledger_sense/config.py`'s `openai_enabled()` /
# `dodo_enabled()` / `tracing_enabled()`. Nothing crashes on a missing key.

# --- OpenAI (matching adjudication / rationale assist / routing fallback) ---

# Your OpenAI API key. Leave unset to keep OpenAI-backed features disabled
# (v1's StubAdjudicator / manual rationale / deterministic routing only).
# Alias: LEDGER_SENSE_OPENAI_API_KEY works too, checked only when this bare
# name is unset (useful if OPENAI_API_KEY is already claimed by another tool
# in this shell). The bare name always wins when both are set.
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY

# Chat-completions model to use for every OpenAI-backed seam. Defaults to a
# cheap tier model when unset.
LEDGER_SENSE_OPENAI_MODEL=gpt-4o-mini

# Hard cap, in USD, on cumulative OpenAI spend per full pipeline run. The
# shared llm_client.py refuses to dispatch any call that would push
# cumulative spend past this cap. Defaults to 1.00 when unset.
LEDGER_SENSE_LLM_COST_CAP_USD=1.00

# --- Dodo Payments (real bank-side sandbox data source) ---

# Your Dodo Payments sandbox API key. Leave unset to keep
# LEDGER_SENSE_DATA_SOURCE=dodo unavailable (falls back to synthetic data
# even if LEDGER_SENSE_DATA_SOURCE is set to "dodo").
# Alias: LEDGER_SENSE_DODO_API_KEY works too, checked only when this bare
# name is unset. The bare name always wins when both are set.
DODO_API_KEY=REPLACE_WITH_YOUR_DODO_SANDBOX_KEY

# Dodo environment to target. "sandbox" is the only environment v2 supports —
# live/production Dodo payment processing is explicitly out of scope.
DODO_ENVIRONMENT=sandbox

# --- Data source switch ---

# Which bank-side data source the pipeline reads from: "synthetic" (v1's
# generator, default, zero external calls) or "dodo" (requires DODO_API_KEY
# above to actually take effect).
LEDGER_SENSE_DATA_SOURCE=synthetic

# --- Neatlogs (tracing/observability) ---

# Your Neatlogs API key. Leave unset to keep tracing disabled — agent CLI
# entrypoints run exactly as in v1, with no spans emitted.
# Alias: LEDGER_SENSE_NEATLOGS_API_KEY works too, checked only when this
# bare name is unset. The bare name always wins when both are set.
NEATLOGS_API_KEY=REPLACE_WITH_YOUR_NEATLOGS_KEY
